# Credentials stay on your machine. This file is loaded automatically; shell variables take precedence.
ATS_UPSTOX_ACCESS_TOKEN=
ATS_UPSTOX_NIFTY_KEY=NSE_INDEX|Nifty 50
# Set a tradeable instrument from Upstox's instrument list, never the index.
ATS_UPSTOX_EXECUTION_KEY=
ATS_AUTOSTART=false
ATS_DB_PATH=data/ats_state.sqlite3
ATS_MODEL_DIR=models
ATS_MIN_OBSERVATIONS=220
ATS_LOOKBACK_DAYS=756
ATS_FORECAST_HORIZON_DAYS=1
ATS_DAILY_PUBLICATION_LAG_MINUTES=15
ATS_LIVE_POLL_SECONDS=30
ATS_POLL_SECONDS_OFFMARKET=1800
ATS_FORECAST_INTERVAL_MARKET=300
ATS_FORECAST_INTERVAL_OFFMARKET=3600
# Optional local API password: the dashboard requests it in Settings. Not an Upstox credential.
ATS_API_TOKEN=
# Opt-in paper evaluation. No broker order endpoints exist.
ATS_LIVE_PAPER_ENABLE=false
ATS_LIVE_PAPER_INTERVAL=60
ATS_PAPER_KILL_SWITCH=data/PAPER_KILL
ATS_LIVE_PAPER_AUDIT_DIR=data/live_paper
ATS_PAPER_TARGET_NOTIONAL=1000
ATS_PAPER_MAX_ORDER_NOTIONAL=2000
ATS_PAPER_MAX_NOTIONAL=10000
ATS_PAPER_MAX_DAILY_LOSS=1000
ATS_PAPER_ALLOW_SHORT=false
# Set explicitly for derivatives using verified contract metadata. Equities normally use one share.
# ATS_PAPER_LOT_SIZE=1
# Combined fees/taxes estimate. Zero excludes costs; configure for your instrument/broker.
ATS_PAPER_FEE_BPS=0
ATS_PAPER_FIXED_FEE=0
